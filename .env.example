# Base PostgreSQL (sur le VPS : base et utilisateur dédiés à SQuizz)
DATABASE_URL=postgresql://squizz_admin:MOT_DE_PASSE@localhost:5432/squizz

# Secret de signature des sessions — obligatoire en production (openssl rand -base64 32)
AUTH_SECRET=

# Adresse publique de l'application
NEXTAUTH_URL=https://www.squizz.fun
APP_URL=https://www.squizz.fun

# Dossier des médias importés (images, vidéos), hors du code
MEDIA_DIR=/opt/squizz-media

# Compte super-admin créé par le seed (npm run db:seed)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Envoi d'emails (invitations, mot de passe oublié, formulaire de contact) — compte Resend de Pressweb :
# SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<clé API Resend>. Sans SMTP, les liens vont dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SQuizz <contact@pressweb.fr>"

# Cloudflare Turnstile (anti-robot du formulaire de contact). Sans ces clés, la vérification est ignorée.
# Cloudflare → Turnstile → Add widget → domaine squizz.fun (mode « Managed »).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Paiement en ligne Stripe (facultatif : sans ces deux clés, les offres se souscrivent par le formulaire de contact).
# Clé secrète : Stripe → Développeurs → Clés API. Secret du webhook : Développeurs → Webhooks → endpoint
# https://www.squizz.fun/api/billing/webhook (événements checkout.session.completed, customer.subscription.*).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Produits ou prix de chaque offre : définis dans lib/plans.ts ; ces variables les remplacent si besoin.
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_PREMIUM=
# Tests uniquement (scripts/e2e.sh) : adresse du faux Stripe local. Ignorée en production.
# STRIPE_API_BASE=http://127.0.0.1:5175

# Google Analytics 4 (mesure d'audience des pages publiques et section « Trafic du site » du super-admin, facultatif).
# ID de mesure (G-XXXXXXXXXX) : lu au build, à mettre dans .env.production sur le Mac. Sans lui, aucun script n'est chargé.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Lecture des chiffres, dans /opt/squizz-secrets.env : ID numérique de la propriété, et compte de service Google Cloud
# ayant le rôle Lecteur sur la propriété. La clé tient sur une ligne, entre guillemets, avec les \n écrits tels quels.
# GA_PROPERTY_ID=
# GA_SERVICE_ACCOUNT_EMAIL=
# GA_SERVICE_ACCOUNT_PRIVATE_KEY=
