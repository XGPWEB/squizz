generator client {
  provider      = "prisma-client-js"
  // "native" for development, OpenSSL 3 for the Ubuntu 24.04 VPS.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// SUPER_ADMIN runs the platform; ORG_ADMIN manages an organisation; HOST (animateur) creates quizzes and runs games.
enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  HOST
}

/// Plans are assigned by hand from the super-admin until online payment is wired in. Limits and prices live in lib/plans.ts.
enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// The tenant: every quiz, game, member and media file belongs to one organisation.
model Organization {
  id                   String             @id @default(cuid())
  name                 String
  plan                 Plan               @default(FREE)
  status               OrganizationStatus @default(ACTIVE)
  /// Set when an administrator stops the paid plan; the super-admin moves the organisation to FREE at the
  /// end of the paid period, which clears it.
  cancelRequestedAt    DateTime?
  /// Partner organisations get the Premium plan for free, whatever `plan` says. Granted by the super-admin.
  partner              Boolean            @default(false)
  partnerSince         DateTime?
  /// Stripe billing, kept in sync by the webhook (app/api/billing/webhook).
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  /// Checkout page currently open for this organisation and the plan it sells: reused or expired before
  /// another one is created, so two payment pages can never lead to two subscriptions.
  checkoutSessionId    String?
  checkoutPlan         Plan?
  /// Short-lived claim taken (atomically, across processes) while a checkout is being prepared with Stripe.
  checkoutLockedUntil  DateTime?
  /// Who holds that claim: only its holder may write the checkout state or release it, so an operation that
  /// outlived the claim cannot disturb the one that replaced it.
  checkoutLockToken    String?
  /// Durable identity of the checkout being prepared, kept until its page is recorded: a retry after a
  /// failure resumes the same operation (same Stripe idempotency key) instead of starting another.
  checkoutOpKey        String?
  /// What that operation sends to Stripe, word for word: a resumed operation repeats exactly this (Stripe
  /// refuses a repeated idempotency key whose parameters differ, e.g. a page expiry computed again).
  checkoutOpParams     Json?
  /// Offer chosen on the pricing page before signing up (a paid plan or « EVENEMENT »): the first sign-in
  /// opens the subscription page on it, whatever link was followed after confirming the address. Emptied
  /// once that page has shown it.
  wantedOffer          String?
  /// Event pass (one-off payment, lib/plans.ts): its limits apply until this date, whatever `plan` says.
  eventPassUntil       DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users       User[]
  invitations Invitation[]
  quizzes     Quiz[]
  rooms       Room[]
  media       Media[]
  auditLogs   AuditLog[]
  eventPasses EventPass[]
}

/// One paid event pass. Keyed by the Stripe Checkout session that paid for it, so a payment reported twice
/// (webhook delivered again, or found again when the page reloads) counts once.
model EventPass {
  sessionId      String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  /// Amount paid, in cents.
  amount         Int
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  passwordHash     String
  role             UserRole      @default(HOST)
  /// Null only for super-admins.
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  active           Boolean       @default(true)
  /// Bumped on password change or deactivation to revoke every open session.
  sessionVersion   Int           @default(0)
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Set when the address is proven: verification link after signup, or accepting an invitation.
  /// Accounts created before verification existed were marked verified by their migration.
  emailVerifiedAt  DateTime?
  createdAt        DateTime      @default(now())

  quizzes            Quiz[]
  quizzesUpdated     Quiz[]                   @relation("QuizUpdatedBy")
  invitationsBy      Invitation[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  /// SHA-256 of the token sent in the link; the raw token is never stored.
  tokenHash      String       @unique
  email          String
  role           UserRole     @default(HOST)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String?
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Signup email check: single use, expires after 24 hours; only the hash is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Quiz {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?        @relation("QuizUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// Bumped by every save: an editor sends the version it opened, so two members never overwrite each other.
  version        Int          @default(0)
  /// Idempotency key sent by the editor: a save retried after a lost response never creates two quizzes.
  clientKey      String?
  title          String
  /// Validated questions (see lib/question.ts).
  questions      Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, clientKey])
  @@index([organizationId])
}

/// A live game. Timestamps are epoch milliseconds so the timing maths matches the client.
model Room {
  code           String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host           String
  /// Snapshot of the quiz at launch, so editing or deleting the quiz never breaks a running game.
  quiz           Json
  phase          String
  question       Int
  started        BigInt
  created        BigInt
  maxPlayers     Int
  /// Idempotency key sent when launching: a retried launch returns the same game instead of a second one.
  clientKey      String?

  players Player[]

  @@unique([organizationId, clientKey])
  @@index([created])
}

model Player {
  code   String
  id     String
  name   String
  /// Removed by the host: excluded from the game and cannot join again.
  kicked Boolean @default(false)
  room   Room    @relation(fields: [code], references: [code], onDelete: Cascade)

  answers Answer[]

  @@id([code, id])
  @@unique([code, name])
}

model Answer {
  code        String
  player      String
  question    Int
  choice      Int
  points      Int
  payload     String @default("")
  correctness Int?
  owner       Player @relation(fields: [code, player], references: [code, id], onDelete: Cascade)

  @@id([code, player, question])
  @@index([code, question])
}

model Media {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String?
  mime           String
  size           Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Sensitive actions (role changes, suspensions, deletions). Kept when the actor is deleted.
model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actorEmail     String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  details        Json?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
}

/// Something went wrong without anyone seeing it on screen (server error, e-mail not sent, billing oddity,
/// health check). Listed on the super-admin's monitoring page; kept 90 days (deploy/purge.mjs).
model SystemAlert {
  id        String   @id @default(cuid())
  /// One of the keys of ALERT_TYPES (lib/monitoring.ts).
  type      String
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One run of a scheduled task on the server (backup, purge), written by the task itself.
model CronRun {
  id         String    @id @default(cuid())
  /// One of the jobs of CRON_JOBS (lib/monitoring.ts).
  job        String
  startedAt  DateTime
  finishedAt DateTime?
  success    Boolean
  detail     String?

  @@index([job, startedAt])
}

/// Sliding-window counters for login and signup throttling.
model RateLimit {
  key       String   @id
  count     Int
  windowEnd DateTime
}

/// Messages sent from the public contact form; also emailed to the publisher when SMTP is configured.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
