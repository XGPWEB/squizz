{
  "name": "squizz",
  "version": "1.31.4",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write app components lib tests prisma/seed.ts deploy/*.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:isolated": "bash scripts/e2e.sh",
    "test:browser": "bash scripts/e2e.sh browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@google-analytics/data": "^6.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.7",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.13",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.7",
    "prettier": "^3.9.9",
    "prisma": "^5.22.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
